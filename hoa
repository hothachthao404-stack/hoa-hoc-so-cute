# --- CHẾ ĐỘ TRẮC NGHIỆM ---
elif st.session_state.page == "quiz":
  if st.button("⬅ Về Lâu Đài"):
    st.session_state.page = "home"
    st.rerun()

  st.markdown(
      "<h2>🌸 Thử Thách Trắc Nghiệm Nguyên Tố</h2>", unsafe_allow_html=True
  )

  # Chọn level
  level = st.selectbox("Chọn Cấp Độ (Level):", [1, 2, 3], format_func=lambda x: f"Level {x}")

  if "current_q" not in st.session_state:
    st.session_state.current_elem = random.choice(ELEMENTS)
    elem = st.session_state.current_elem
    correct = elem["name"] if level != 3 else elem["symbol"]
    wrong_pool = (
        [e["name"] for e in ELEMENTS if e["name"] != correct]
        if level != 3
        else [e["symbol"] for e in ELEMENTS if e["symbol"] != correct]
    )
    options = random.sample(wrong_pool, 3) + [correct]
    random.shuffle(options)
    st.session_state.options = options
    st.session_state.correct = correct

  elem = st.session_state.current_elem
  if level == 1:
    q_text = f"Tên tiếng Anh (IUPAC) của nguyên tố ký hiệu **{elem['symbol']}** là gì?"
  elif level == 2:
    q_text = (
        f"Nguyên tố nào có nguyên tử khối KLNT = {elem['mass']} và ký hiệu"
        f" **{elem['symbol']}**?"
    )
  else:
    q_text = (
        f"Nguyên tố **{elem['name']}** có số hiệu nguyên tử {elem['number']}."
        " Ký hiệu là gì?"
    )

  st.write(q_text)

  ans = st.radio("Chọn đáp án đúng:", st.session_state.options, key="quiz_choice")

  if st.button("Gửi Đáp Án"):
    if ans == st.session_state.correct:
      st.success("🎉 Chính xác tuyệt vời! +10 điểm 💕")
      st.session_state.score += 10
    else:
      st.error(
          f"❌ Sai rồi! Đáp án đúng là: **{st.session_state.correct}**"
      )

    # Đổi câu hỏi mới
    if st.button("Câu hỏi tiếp theo ➡"):
      del st.session_state.current_q
      st.rerun()

  st.markdown(f"**Điểm hiện tại:** {st.session_state.score}")

